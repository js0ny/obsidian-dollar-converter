{
	"name": "math-dollar-converter",
	"version": "1.0.0",
	"description": "Convert bracket maths to dollar-delimited formulae in Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"package": "npm run build && node package.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.5",
		"@codemirror/language": "^6.0.0",
		"@codemirror/state": "^6.0.0",
		"@codemirror/view": "^6.0.0",
		"esbuild": "0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"obsidian": "latest",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1"
	}
}
